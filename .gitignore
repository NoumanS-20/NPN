# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Data & models (large, regenerated from source datasets)
data/raw/
data/interim/

# data/processed is NOT ignored. It is 892 KB, it is deterministic (every seed is
# pinned), and the Dockerfiles copy it. Committing it means the repository builds
# into a running container anywhere — Render, Cloud Run, a judge's laptop —
# without Kaggle credentials or a four-minute pipeline run first.
data/processed/*.sqlite
*.db
*.sqlite
*.sqlite3
models/*.joblib
models/*.pkl
models/*.json.gz

# Secrets — never commit
.env
.env.*
kaggle.json
*.pem

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Space staging output
build/
